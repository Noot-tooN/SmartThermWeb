# Documentation only: the app does not automatically load .env files.
# OCSTAT is the default provider.
SMARTTHERM_PROVIDER=ocstat
SMARTTHERM_BIND=127.0.0.1:3000
# Sign in and log out through the browser. Every server start begins signed out.
# Credentials are not loaded from files or environment variables.
# Simulator is an explicit development/test option only:
# SMARTTHERM_PROVIDER=simulator
# SMARTTHERM_SIM_CONFIG='{"scenario":"normal","ack_ms":900,"apply_ms":2400}'

# Hosting behind a local HTTPS reverse proxy (preserve the browser Host and Origin):
# SMARTTHERM_PUBLIC_ORIGIN=https://heating.homeserver.com
