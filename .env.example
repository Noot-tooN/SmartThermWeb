# Documentation only: the app does not automatically load .env files.
# Export these variables in your shell when overriding defaults.
SMARTTHERM_PROVIDER=simulator
SMARTTHERM_BIND=127.0.0.1:3000
# Times are measured from dispatch; applies may precede the server reply.
SMARTTHERM_SIM_CONFIG='{"scenario":"normal","ack_ms":900,"apply_ms":2400}'
# OCSTAT is deliberately disabled. Never put real credentials in this file.
